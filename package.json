{
  "name": "versuai-interview",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-check --fail-on-warnings",
    "test": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.js *.json index.html README.md",
    "format:check": "prettier --check src tests *.js *.json index.html README.md"
  },
  "dependencies": {
    "lucide-svelte": "^0.468.0",
    "papaparse": "^5.5.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0"
  }
}
